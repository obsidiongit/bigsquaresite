# Template for .env.local (local development). Production values live on
# the Vercel project. Secrets (tokens) go in Vercel as Sensitive and in
# .env.local only; never in a committed file or in chat.
# See project-sections/conversion/lead-funnel.md.

# Fallback lead destination: the GHL "Website form inbound" workflow's
# inbound webhook. Used when the GHL API write fails or is not configured.
FORM_WEBHOOK_URL=

# GHL (LeadConnector) API for the BigSquare Marketing sub-account.
# GHL_API_KEY is a Private Integration token (secret). Leads go through the
# API only when both the key and the location id are set.
GHL_API_KEY=
GHL_LOCATION_ID=
# Booking calendar ("Strategy Call (website)"), for the pick-a-time step
GHL_CALENDAR_ID=
# Pick-a-time step on /schedule/. BOOKING_ENABLED=1 turns it on (needs the
# GHL key, location, calendar and the secret); keep it off in production
# until Levi and Brad connect Google Calendar. BOOKING_TOKEN_SECRET signs
# the booking token (secret; any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
BOOKING_ENABLED=
BOOKING_TOKEN_SECRET=

# Tracking (components render nothing while empty)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_GA4_ID=

# Meta Conversions API (server-side twin of the pixel events). Token is a
# secret from Events Manager > pixel > Settings > Conversions API.
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code, QA only, never in production
META_TEST_EVENT_CODE=
# Optional: Graph API version override (default v23.0)
META_GRAPH_VERSION=
