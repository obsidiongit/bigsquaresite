# All values intentionally empty (decisions.md). A teammate fills them in on
# a separate pass. Copy to .env.local for local development.

# Single webhook every form posts to (GHL or Obsidion dashboard, decided later)
FORM_WEBHOOK_URL=

# Custom GHL booking component (Phase 5)
GHL_API_KEY=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# Tracking (components render nothing while empty)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_GA4_ID=

# Rolling deadline for the ad credit popup (Phase 3), e.g. 2026-09-30
POPUP_DEADLINE=
