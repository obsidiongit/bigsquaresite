# All values intentionally empty (decisions.md). A teammate fills them in on
# a separate pass. Copy to .env.local for local development.

# GoHighLevel inbound webhook. Every form posts JSON here through
# lib/form-action.ts (contact, newsletter, audit, apply, ...).
# Create the webhook in GHL, paste the URL, redeploy.
FORM_WEBHOOK_URL=

# Custom GHL booking component (Phase 5)
GHL_API_KEY=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# Tracking (components render nothing while empty)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_GA4_ID=
